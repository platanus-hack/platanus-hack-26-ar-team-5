# Anthropic — required for live demos and the Claude driver
ANTHROPIC_API_KEY=sk-ant-...

# --- Supabase (auth + per-user usage tracking) ---
# Browser-visible
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Server-only (service role — DO NOT expose). Used to write usage_events and
# auto-promote allow-listed users on first sign-in.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Public origin used by the Supabase OAuth redirect handler. Locally:
# http://localhost:3000  · Production: https://your-domain.com
PACTA_PUBLIC_BASE_URL=http://localhost:3000

# Comma-separated emails that get profile.allowed=true on first sign-in.
# Anyone not on the list lands on /dashboard with a "request access" notice
# and cannot mint an API key. Leave empty to require manual promotion in
# the Supabase dashboard.
ALLOWED_EMAILS=

# Comma-separated emails that get admin-tier treatment on first sign-in:
# allowed=true + monthly_quota_disputes=500 + monthly_quota_tokens=10M.
# Strict superset of ALLOWED_EMAILS — an email here doesn't need to be in
# both lists. Leave empty if you don't want any admins.
ADMIN_EMAILS=

# --- Storage (Pacta dispute state) ---
# Optional. Without these, the engine falls back to in-process memory.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
